# Build directories
build/
build-*/
cmake-build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
cmake_install.cmake
compile_commands.json
Makefile
install_manifest.txt

# Binaries and libraries
*.out
*.app
*.exe
*.dll
*.so
*.dylib
*.a
*.o
*.obj
.claude
.agents/

# Test and runtime artifacts
Testing/
test-results/
*.log
__pycache__/
*.py[cod]

# Local PipeShellX operator state. These root-level defaults are generated by
# examples and normal CLI use; intentionally versioned samples should use a
# distinct name. Existing tracked test fixtures remain tracked.
/inventory.ini
# Local fleet inventories name real hosts, users and IPs: never commit them.
/fleet.ini
/*.ini.local
/clients.txt
/*.known_hosts
/*.jsonl
/*.sock
/*.pid

# Locally generated CA and identity material. Never commit real private keys.
/ca/
/*.key
/*.crt
/*.csr
/*.pem
/*.p12
/*.pfx
/revoked.txt

# macOS
.DS_Store

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~
